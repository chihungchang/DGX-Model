--- a/zig/src/families/dsv41/model.zig
+++ b/zig/src/families/dsv41/model.zig
@@ -32,6 +32,21 @@
 
 /// The served prompt chunk (TF_DS_PREFILL_CHUNK): a prompt runs in chunks that start at its multiples.
 pub const chunk_rows = 4096;
+
+/// The API's prompt/reply window excludes the draft round and allocator alignment.
+fn contextExtent(context: usize, pool: usize, rows: usize) usize {
+    if (context == 0) return pool;
+    return @min(std.mem.alignForward(usize, context + rows + 2, chunk_rows), pool);
+}
+
+test "four full 256K API windows retain round scratch inside their shared pool" {
+    const cap = contextExtent(262144, 1114112, 16);
+    try std.testing.expectEqual(@as(usize, 266240), cap);
+    try std.testing.expect(4 * cap <= 1114112);
+    try std.testing.expectEqual(@as(usize, 1114112), contextExtent(0, 1114112, 16));
+    try std.testing.expectEqual(@as(usize, 262144), contextExtent(262144, 262144, 16));
+}
+
 /// Rows between resume points: the served build's 2048-row grid. Kept states land on it; a pass is cut short to end at
 /// the next one it keeps, so a longer pass resumes where a 2048-row pass would.
 pub const resume_rows = 2048;
