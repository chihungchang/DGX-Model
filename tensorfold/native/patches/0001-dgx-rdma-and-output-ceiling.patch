+        try std.testing.expectEqual(@as(u8, 3), Probe.gid);
+    }
+    Probe.calls = 0;
+    peers[1].active_mtu[0] = 0;
+    try std.testing.expectError(error.BadMtu, r.connect(&peers));
+    try std.testing.expectEqual(@as(usize, 0), Probe.calls);
+}
