#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROFILE_DIR="${ROOT_DIR}/profiles"
ACTIVE_FILE="${ROOT_DIR}/.active-profile"
VALIDATED_FILE="${ROOT_DIR}/.validated-profile"
PROFILE_TOOL="${ROOT_DIR}/runtime/profile.py"
COMPOSE_FILE="${ROOT_DIR}/compose.yaml"

fail() {
  printf 'error: %s\n' "$*" >&2
  exit 1
}

profile_path() {
  local profile="$1"
  [[ "${profile}" =~ ^[a-z0-9][a-z0-9-]*$ ]] || fail "invalid profile name: ${profile}"
  local path="${PROFILE_DIR}/${profile}.args"
  [[ -f "${path}" ]] || fail "profile does not exist: ${profile}"
  printf '%s\n' "${path}"
}

active_profile() {
  [[ -f "${ACTIVE_FILE}" ]] || return 1
  local profile
  IFS= read -r profile < "${ACTIVE_FILE}"
  [[ -n "${profile}" ]] || return 1
  printf '%s\n' "${profile}"
}

compose() {
  local profile="$1"
  shift
  AUDIO_PROFILE="${profile}" docker compose --project-directory "${ROOT_DIR}" -f "${COMPOSE_FILE}" "$@"
}

profile_value() {
  local path="$1"
  local scope="$2"
  local key="$3"
  python3 "${PROFILE_TOOL}" value "${path}" "${scope}" -- "${key}"
}

profile_fingerprint() {
  python3 "${PROFILE_TOOL}" deployment-fingerprint "$1"
}

container_state() {
  local name="$1"
  docker inspect --format '{{.State.Status}}/{{if .State.Health}}{{.State.Health.Status}}{{else}}none{{end}}' "${name}" 2>/dev/null || printf 'missing\n'
}

validation_state() {
  local profile="$1"
  local path="$2"
  [[ -f "${VALIDATED_FILE}" ]] || { printf 'unvalidated\n'; return; }
  local stored_profile stored_fingerprint
  IFS=' ' read -r stored_profile stored_fingerprint < "${VALIDATED_FILE}" || true
  if [[ "${stored_profile}" == "${profile}" && "${stored_fingerprint}" == "$(profile_fingerprint "${path}")" ]]; then
    printf 'validated\n'
  else
    printf 'stale-validation\n'
  fi
}

deployment_state() {
  local profile="$1"
  local path="$2"
  local asr_state tts_state validation
  asr_state="$(container_state mazi-qwen3-asr)"
  tts_state="$(container_state mazi-qwen3-tts)"
  validation="$(validation_state "${profile}" "${path}")"
  if [[ "${asr_state}" == "running/healthy" && "${tts_state}" == "running/healthy" ]]; then
    if [[ "${validation}" == "validated" ]]; then
      printf 'ready\n'
    else
      printf 'healthy/%s\n' "${validation}"
    fi
  elif [[ "${asr_state}" == "missing" && "${tts_state}" == "missing" ]]; then
    printf 'stopped\n'
  else
    printf 'asr=%s,tts=%s\n' "${asr_state}" "${tts_state}"
  fi
}

resolve_profile() {
  if [[ $# -gt 0 && -n "${1:-}" ]]; then
    printf '%s\n' "$1"
  else
    active_profile || fail "no active profile; pass a profile or run: ./audio-model use <profile>"
  fi
}

cmd_list() {
  local active=""
  active="$(active_profile 2>/dev/null || true)"
  printf '%-6s %-16s %-8s %-8s %-9s %-28s %s\n' ACTIVE PROFILE ASR_PORT TTS_PORT ASR_WIN STATE MODELS
  local path profile mark state asr_port tts_port asr_window asr_model tts_model
  shopt -s nullglob
  for path in "${PROFILE_DIR}"/*.args; do
    profile="$(basename "${path}" .args)"
    python3 "${PROFILE_TOOL}" validate "${path}" >/dev/null
    mark=""
    state="available"
    if [[ "${profile}" == "${active}" ]]; then
      mark="*"
      state="$(deployment_state "${profile}" "${path}")"
    fi
    asr_port="$(profile_value "${path}" asr --port)"
    tts_port="$(profile_value "${path}" tts --port)"
    asr_window="$(profile_value "${path}" asr --chunk-size-sec)s"
    asr_model="$(profile_value "${path}" asr --asr-model-path)"
    tts_model="$(profile_value "${path}" tts --model)"
    printf '%-6s %-16s %-8s %-8s %-9s %-28s %s | %s\n' "${mark}" "${profile}" "${asr_port}" "${tts_port}" "${asr_window}" "${state}" "${asr_model}" "${tts_model}"
  done
}

cmd_verify() {
  bash -n "${ROOT_DIR}/audio-model"
  python3 -m py_compile \
    "${ROOT_DIR}/runtime/profile.py" \
    "${ROOT_DIR}/asr/server.py" \
    "${ROOT_DIR}/scripts/smoke.py" \
    "${ROOT_DIR}/scripts/test_static.py"
  python3 "${ROOT_DIR}/scripts/test_static.py"
  printf 'Offline profile and smoke contract verification passed.\n'
}

cmd_config() {
  local profile
  profile="$(resolve_profile "${1:-}")"
  local path
  path="$(profile_path "${profile}")"
  python3 "${PROFILE_TOOL}" validate "${path}"
  compose "${profile}" config --quiet
  printf 'compose: valid\nprofile: %s\n' "${profile}"
}

cmd_pull() {
  local profile
  profile="$(resolve_profile "${1:-}")"
  local path
  path="$(profile_path "${profile}")"
  python3 "${PROFILE_TOOL}" validate "${path}" >/dev/null
  compose "${profile}" build --pull
  printf 'Images built. Model weights download on first use into mazi-audio-hf-cache.\n'
}

cmd_use() {
  [[ $# -eq 1 ]] || fail "usage: ./audio-model use <profile>"
  local profile="$1"
  local path
  path="$(profile_path "${profile}")"
  python3 "${PROFILE_TOOL}" validate "${path}" >/dev/null
  compose "${profile}" config --quiet
  rm -f "${VALIDATED_FILE}"
  compose "${profile}" up -d --build
  printf '%s\n' "${profile}" > "${ACTIVE_FILE}"
  printf 'Profile %s started. It is not deployment-ready until ./audio-model smoke passes.\n' "${profile}"
}

cmd_status() {
  local profile
  profile="$(resolve_profile "${1:-}")"
  local path
  path="$(profile_path "${profile}")"
  compose "${profile}" ps
  printf 'profile=%s state=%s validation=%s\n' \
    "${profile}" \
    "$(deployment_state "${profile}" "${path}")" \
    "$(validation_state "${profile}" "${path}")"
}

cmd_logs() {
  local profile
  profile="$(resolve_profile)"
  local service="${1:-}"
  case "${service}" in
    "") compose "${profile}" logs --tail 200 -f ;;
    asr|tts) compose "${profile}" logs --tail 200 -f "${service}" ;;
    *) fail "logs service must be asr or tts" ;;
  esac
}

cmd_smoke() {
  local audio_only=false
  if [[ "${1:-}" == "--audio-only" ]]; then
    audio_only=true
    shift
  fi
  local profile
  profile="$(resolve_profile "${1:-}")"
  local path
  path="$(profile_path "${profile}")"
  [[ "$(active_profile 2>/dev/null || true)" == "${profile}" ]] || fail "smoke requires the active profile"
  if [[ "${audio_only}" == true ]]; then
    python3 "${ROOT_DIR}/scripts/smoke.py" --audio-only "${path}"
    printf 'Audio-only diagnostic passed; deployment readiness was not recorded.\n'
  else
    python3 "${ROOT_DIR}/scripts/smoke.py" "${path}"
    printf '%s %s\n' "${profile}" "$(profile_fingerprint "${path}")" > "${VALIDATED_FILE}"
    printf 'Concurrent LLM + ASR + TTS smoke passed; deployment is ready.\n'
  fi
}

cmd_stop() {
  local profile
  profile="$(resolve_profile)"
  compose "${profile}" down
  rm -f "${ACTIVE_FILE}" "${VALIDATED_FILE}"
}

usage() {
  cat <<'EOF'
Usage: ./audio-model <command> [arguments]

Commands:
  list                         List args profiles and live deployment state
  verify                       Run offline profile and smoke contract checks
  config [profile]             Validate a profile and rendered Compose config
  pull [profile]               Pull/build pinned ARM64 runtime images
  use <profile>                Build and start ASR + TTS (clears readiness gate)
  status [profile]             Show containers and deployment readiness
  logs [asr|tts]               Follow the active deployment logs
  smoke [--audio-only] [name]  Exercise audio, or concurrent LLM+ASR+TTS and mark ready
  stop                         Stop the active audio deployment
EOF
}

command="${1:-help}"
shift || true
case "${command}" in
  list) cmd_list "$@" ;;
  verify) cmd_verify "$@" ;;
  config) cmd_config "$@" ;;
  pull) cmd_pull "$@" ;;
  use) cmd_use "$@" ;;
  status) cmd_status "$@" ;;
  logs) cmd_logs "$@" ;;
  smoke) cmd_smoke "$@" ;;
  stop) cmd_stop "$@" ;;
  help|-h|--help) usage ;;
  *) usage >&2; fail "unknown command: ${command}" ;;
esac
