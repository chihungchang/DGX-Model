# Only LLM engines and shared scripts belong in this repository.
# Root-level files remain eligible for tracking.
/*/
!/llama.cpp/
!/vllm/
!/sglang/
!/scripts/
!/tensorfold/

# Benchmark scripts, results, and downloaded benchmark sources
benchmarks/
/sglang/BENCHMARKS.md
/sglang/assessments/

# Local secrets and machine-specific configuration
.env
.env.*
*.env
*.env.*
!.env.example
!*.env.example
*.pem
*.key
*.crt
*.cer
*.der
*.csr
*.p12
*.pfx
*.p7b
*.p7c
*.jks
*.keystore
*.keytab
id_rsa*
id_dsa*
id_ecdsa*
id_ed25519*
.ssh/
.aws/
.azure/
.kube/
.netrc
.npmrc
.pypirc
.git-credentials
credentials
credentials.*
secrets/
secrets.*
passwords
passwords.*

# Python and test caches
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Editors and operating systems
.DS_Store
.idea/
.vscode/
*~

# Backups are local safety copies, never authoritative repository sources
**/.backup*/
**/backup/
**/backups/
*.bak
*.backup
*.old
*.orig
*-bak
*-backup
*.codex-baseline-*

# TensorFold node configuration, caches, and deployment receipts
/tensorfold/.state/
/tensorfold/node*.env
/tensorfold/vendor/deepseek-v41/.env
